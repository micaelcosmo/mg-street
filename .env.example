# =============================================================
# MG Street - variáveis de ambiente (modelo)
# Copie para .env e ajuste. NUNCA versione o .env real.
# =============================================================

# --- PostgreSQL ---
POSTGRES_USER=mgstreet_user
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=mgstreet
# Em docker-compose use POSTGRES_HOST=db; localmente use localhost.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Aplicação Flask ---
PORT=5001
FLASK_ENV=development
# Segredos: gere valores longos e aleatórios em produção.
SECRET_KEY=troque_por_um_segredo_forte
JWT_SECRET=troque_por_um_segredo_jwt_forte
# Horas até o token JWT expirar.
JWT_EXP_HOURS=12
# Rate limit do login: tentativas permitidas por janela (segundos), por IP+email.
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW=60
# Salt do hash de senha. NÃO altere em um banco já populado
# (invalidaria todos os hashes existentes).
PASSWORD_SALT=mgstreet_salt

# --- Seed de usuários (criados na 1ª inicialização) ---
ADMIN_EMAIL=admin@mgstreet.com
ADMIN_PASSWORD=troque_esta_senha_admin
DEMO_EMAIL=cliente@mgstreet.com
DEMO_PASSWORD=troque_esta_senha_demo

# --- Pagamento (Mercado Pago Checkout Pro) ---
# Access Token de TESTE do painel de devs do Mercado Pago (sandbox). Sem ele, o checkout
# funciona no modo atual (pedido sem pagamento). NUNCA versione o token real.
MP_ACCESS_TOKEN=
# URL pública base para back_urls/webhook (em dev, localhost; em prod, seu domínio https).
PUBLIC_BASE_URL=http://localhost:5001

# --- E-mail transacional (opcional) ---
# Sem SMTP_HOST, os e-mails são apenas logados (modo dev). Para envio real, configure um
# SMTP (ex.: provedor com tier gratuito).
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=1
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@mgstreet.local
